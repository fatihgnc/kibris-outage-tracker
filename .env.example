# Copy to .env.local and fill in. Never commit .env.local.

# Supabase. The local stack (`npx supabase start`) prints these; this project
# uses a shifted port range so it does not collide with another local project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ingest only. Bypasses row level security — never NEXT_PUBLIC_*, never
# imported by a component or a route handler.
SUPABASE_SERVICE_ROLE_KEY=

# Contact address published in the ingest's User-Agent (SPEC §10.3).
INGEST_CONTACT=

# 'true' serves lib/mock.ts instead of the database, and suppresses every ad
# slot so development and screenshots stay clean (SPEC §11.4).
USE_MOCKS=false

# Stage 2 of the parser (SPEC §10.4). Set ONE of these — whichever account you
# have. OPENAI_API_KEY wins if both are set. Without either, the LLM fallback is
# skipped and unparsed announcements go straight to the review queue, which is a
# supported way to run: Stage 1 handles the large majority on its own.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override. Defaults: gpt-4o-mini for OpenAI, claude-sonnet-5 for
# Anthropic. Set this if your account does not have the default.
LLM_MODEL=

# Advertising (Phase C, step 24). Leave every one of these blank until an ad
# account has actually been approved: AdSlot renders nothing without them, and
# enabling slots is meant to happen one at a time (SPEC §13 step 25).
NEXT_PUBLIC_AD_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_HOME_MID=
NEXT_PUBLIC_AD_SLOT_DISTRICT_MID=
NEXT_PUBLIC_AD_SLOT_GUIDE=
NEXT_PUBLIC_AD_SLOT_ARCHIVE=

# Absolute site URL, used for canonical and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

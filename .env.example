# Copy to .env.local for local development. Never commit .env.local.
#
# Two separate runtimes read these, and they must NOT get the same set:
#
#   [app]    the Next.js site — on Vercel. Reads the database read-only.
#   [ingest] the cron script — NOT on Vercel (SPEC §8: never a route handler).
#            Runs on GitHub Actions, a VPS, or your own machine.
#
# NEXT_PUBLIC_ is a "may be published" marker: Next.js inlines the value into
# any bundle that reads it. Never put a secret behind that prefix. `npm run
# build` refuses if anything under app/ or components/ touches a service role
# key (scripts/check-secrets.mjs).

# ---------------------------------------------------------------- app + ingest
# Hosted: https://<project-ref>.supabase.co   Local: http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_URL=

# --------------------------------------------------------------------- app only
# Dashboard > Settings > API Keys. Use the publishable key (sb_publishable_...)
# or the legacy anon JWT — both work. Safe to expose: row level security grants
# anon nothing but select on outages and ingest_runs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 'true' serves lib/mock.ts instead of the database and suppresses every ad
# slot. Set 'false' in production.
USE_MOCKS=false

# Absolute site URL for canonical and Open Graph metadata, e.g.
# https://kesintimivar.com — no trailing slash.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------ ingest only
# NEVER set these in Vercel. The site never reads them, and the secret key
# bypasses row level security entirely.
#
# Dashboard > Settings > API Keys. The secret key (sb_secret_...) or the legacy
# service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Contact address published in the ingest's User-Agent (SPEC §10.3).
INGEST_CONTACT=

# Stage 2 of the parser (SPEC §10.4). Set ONE — whichever account you have;
# OPENAI_API_KEY wins if both are set. Without either, the LLM fallback is
# skipped and unparsed announcements go to the review queue, which is a
# supported way to run: Stage 1 handles the large majority on its own.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override. Defaults: gpt-4o-mini for OpenAI, claude-sonnet-5 for
# Anthropic. Set this if your account does not have the default.
LLM_MODEL=

# ---------------------------------------------------------------- app, later on
# Advertising (SPEC §13 step 24). Leave blank until an ad account is actually
# approved: AdSlot renders nothing without them, and slots are meant to be
# enabled one at a time (step 25).
NEXT_PUBLIC_AD_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_HOME_MID=
NEXT_PUBLIC_AD_SLOT_DISTRICT_MID=
NEXT_PUBLIC_AD_SLOT_GUIDE=
NEXT_PUBLIC_AD_SLOT_ARCHIVE=

{
  "name": "kibris-kesinti-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"ingest/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "ingest": "node --import tsx ingest/run.ts",
    "backfill": "node --import tsx ingest/backfill.ts",
    "backfill:area-keys": "node --import tsx scripts/backfill-area-keys.ts",
    "backfill:scope": "node --import tsx scripts/backfill-scope.ts",
    "audit": "node --import tsx scripts/audit-records.ts",
    "retire": "node --import tsx scripts/retire-records.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build:map": "node --import tsx scripts/build-map-geometry.ts",
    "build:icons": "node --import tsx scripts/build-icons.ts",
    "prebuild": "node scripts/check-secrets.mjs && npm run build:map",
    "harvest:places": "node --import tsx scripts/harvest-places.ts",
    "harvest:coords": "node --import tsx scripts/harvest-coords.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3-geo": "^3.1.1",
    "marked": "^18.0.10",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
